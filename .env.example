# Values from Supabase → Project Settings → API. Publishable key only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional services. Keep disabled until their provider setup is complete.
NEXT_PUBLIC_APP_URL=https://hub-one-azure.vercel.app
NEXT_PUBLIC_AZURE_SSO_ENABLED=false
NEXT_PUBLIC_PUSH_ENABLED=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server only: never add NEXT_PUBLIC_ to these names.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common
HUB_INTEGRATION_ENCRYPTION_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
