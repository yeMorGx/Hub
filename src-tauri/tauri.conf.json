{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hub",
  "version": "0.1.6",
  "identifier": "app.hub.team",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://hub-one-azure.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZULU",
        "width": 1360,
        "height": 900,
        "minWidth": 390,
        "minHeight": 640,
        "url": "https://hub-one-azure.vercel.app",
        "visible": false
      },
      {
        "label": "mini-timer",
        "title": "ZULU \u2014 Mini timer",
        "url": "https://hub-one-azure.vercel.app/desktop/timer",
        "width": 392,
        "height": 88,
        "x": 24,
        "y": 24,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "transparent": true
      }
    ],
    "security": {
      "capabilities": [
        "hub-app"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "deb"
    ],
    "shortDescription": "ZULU \u2014 um espa\u00e7o para seu time trabalhar.",
    "category": "Productivity",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "publisher": "Hub",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Hub",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0MkNCQkIzNTEyNUY5MDcKUldRSCtTVlJzN3NzdExuWlBVRGNlMXhTK0JJeGpJZFB3cVhDWEx1dmUyZVc1cnhUZnJqSDk3Nk8K",
      "endpoints": [
        "https://hub-one-azure.vercel.app/api/desktop/manifest"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
